SUPERVISOR_NAME=
SUPERVISOR_EMAIL=
SUPERVISOR_PASSWORD=
# Used only by npm run bootstrap. Choose your own credentials; no demo password is seeded.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=
