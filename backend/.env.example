NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://pcd:change-me@localhost:5432/pcd
FRONTEND_ORIGIN=http://localhost:5173
SESSION_HOURS=12
# Exact API origin used to open Swagger UI; also trusted for authenticated writes.
API_ORIGIN=http://localhost:3001
